@startuml use-cases-operations
!include style.iuml
left to right direction
skinparam nodesep 14
skinparam ranksep 70

actor "Store admin" as A
actor "Razorpay" as R <<external system>>
actor "Scheduler" as S <<timer>>

rectangle "DashCart backend: operations" {
  usecase "Manage stores and\nserviceable pincodes" as UC10
  usecase "Manage categories\nand products" as UC11
  usecase "Set store stock" as UC12
  usecase "Advance fulfilment\n(packed, out, delivered)" as UC13
  usecase "Switch checkout strategy" as UC14
  usecase "View metrics" as UC14b
  usecase "Deliver payment webhook" as UC15
  usecase "Expire unpaid orders" as UC16
  usecase "Verify payment\nsignature" as UC6a
  usecase "Release reserved\nstock" as UC17
}

A --> UC10
A --> UC11
A --> UC12
A --> UC13
A --> UC14
A --> UC14b
R --> UC15
S --> UC16
UC15 ..> UC6a : <<include>>
UC16 ..> UC17 : <<include>>
@enduml
