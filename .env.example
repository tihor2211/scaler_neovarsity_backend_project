# Copy to .env (gitignored) and uncomment what you need. docker compose --profile app reads it.
# Leave a line commented rather than empty: an empty value overrides the app's default.
# Without any of these the app runs with dev defaults and a fake payment gateway.

# First admin user, created on startup when both are set
# ADMIN_EMAIL=admin@dashcart.local
# ADMIN_PASSWORD=

# Base64 secret of 256+ bits, e.g. `openssl rand -base64 48`. Required outside local development.
# JWT_SECRET=

# Razorpay test mode (Dashboard -> Test Mode -> API Keys / Webhooks)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# NAIVE | OPTIMISTIC | PESSIMISTIC | CONDITIONAL_UPDATE (default) | REDIS
# CHECKOUT_STRATEGY=CONDITIONAL_UPDATE
